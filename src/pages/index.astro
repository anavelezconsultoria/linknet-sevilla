---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Planes from '../components/Planes.astro';
import Franja from '../components/Franja.astro';
import Adicionales from '../components/Adicionales.astro';
import CoberturaPagos from '../components/CoberturaPagos.astro';
import Contacto from '../components/Contacto.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
---

<BaseLayout>
  <SiteHeader />
  <main>
    <Hero />
    <Cinta />
    <Servicios />
    <Planes />
    <Franja />
    <Adicionales />
    <CoberturaPagos />
    <Contacto />
  </main>
  <SiteFooter />
  <WhatsappFlotante />
</BaseLayout>
