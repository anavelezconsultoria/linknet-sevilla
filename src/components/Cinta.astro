---
/** Cinta continua con todo lo que hace LinkNet. Se pausa al pasar el mouse. */
const PALABRAS = [
  'Internet ilimitado',
  'Cámaras de seguridad',
  'Wi-Fi para fincas',
  'Vigilancia',
  'Enlaces inalámbricos',
  'Telefonía IP',
  'Energía solar',
  'Drones',
] as const;
---

<div class="cinta" role="region" aria-label="Servicios de LinkNet">
  <div class="pista">
    {[0, 1].map((copia) => (
      <ul aria-hidden={copia === 1 ? 'true' : undefined}>
        {PALABRAS.map((p) => <li>{p}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .cinta {
    overflow: hidden;
    background: var(--degradado-marca);
    transform: rotate(-1.2deg);
    margin: -26px -10px 0;
    position: relative;
    z-index: 2;
    box-shadow: 0 20px 40px -24px rgba(232, 67, 43, 0.6);
  }

  .pista {
    display: flex;
    width: max-content;
    animation: desplazar 32s linear infinite;
  }

  .cinta:hover .pista {
    animation-play-state: paused;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 18px 0 18px 28px;
    font-family: var(--fuente-marca);
    font-size: clamp(13px, 1.4vw, 16px);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1b1200;
    white-space: nowrap;
  }

  li::after {
    content: '';
    width: 10px;
    height: 10px;
    transform: rotate(45deg);
    background: var(--noche);
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }
</style>
