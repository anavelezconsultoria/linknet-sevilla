---
import Icono from './Icono.astro';
import { enlaceWhatsapp, servicios } from '../data/negocio';
---

<section class="seccion" id="servicios">
  <div class="contenedor">
    <div data-aparece>
      <p class="etiqueta">Lo que hacemos</p>
      <h2 class="titulo-seccion">Tecnología para el campo, <em>con instalación incluida</em></h2>
      <p class="intro">Llevamos internet y seguridad a las veredas, con equipos instalados y configurados para que solo te preocupes por usarlos.</p>
    </div>

    <ul class="tarjetas">
      {servicios.map((s, i) => (
        <li class="tarjeta" style={`--i: ${i}`} data-aparece>
          <span class="icono-caja"><Icono nombre={s.icono} /></span>
          <h3>{s.titulo}</h3>
          <p>{s.descripcion}</p>
          <a class="mas" href={enlaceWhatsapp(s.mensaje)} target="_blank" rel="noopener">
            Me interesa <Icono nombre="flecha" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 22px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  /* 3 arriba y 2 abajo, mas anchas: la fila de abajo no queda coja. */
  .tarjeta {
    grid-column: span 2;
  }

  .tarjeta:nth-child(4),
  .tarjeta:nth-child(5) {
    grid-column: span 3;
  }

  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--linea);
    box-shadow: var(--sombra);
    overflow: hidden;
    isolation: isolate;
    transition: transform 400ms var(--salida), box-shadow 400ms;
  }

  .tarjeta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at 0% 0%, rgba(246, 194, 30, 0.14), transparent 55%);
    opacity: 0;
    transition: opacity 400ms;
  }

  .tarjeta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--degradado-marca);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--salida);
  }

  .tarjeta:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-fuerte);
  }

  .tarjeta:hover::before {
    opacity: 1;
  }

  .tarjeta:hover::after {
    transform: scaleX(1);
  }

  .icono-caja {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 18px;
    color: #fff;
    background: var(--degradado-marca);
    box-shadow: 0 14px 26px -12px rgba(232, 67, 43, 0.7);
    transition: transform 500ms var(--salida);
  }

  .tarjeta:nth-child(2n) .icono-caja {
    background: var(--degradado-verde);
    box-shadow: 0 14px 26px -12px rgba(46, 157, 59, 0.7);
  }

  .tarjeta:hover .icono-caja {
    transform: rotate(-8deg) scale(1.08);
  }

  .icono-caja :global(.icono) {
    width: 30px;
    height: 30px;
  }

  h3 {
    font-size: 22px;
  }

  p {
    color: var(--tenue);
    flex: 1;
  }

  .mas {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--naranja-fuerte);
    text-decoration: none;
  }

  .mas :global(.icono) {
    width: 18px;
    height: 18px;
    transition: transform 300ms var(--salida);
  }

  .mas:hover :global(.icono) {
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tarjeta,
    .tarjeta:nth-child(4),
    .tarjeta:nth-child(5) {
      grid-column: span 1;
    }
    .tarjeta:nth-child(5) {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .tarjetas {
      grid-template-columns: minmax(0, 1fr);
    }
    .tarjeta:nth-child(5) {
      grid-column: span 1;
    }
  }
</style>
