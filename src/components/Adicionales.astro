---
import Icono from './Icono.astro';
import { adicionales, enlaceWhatsapp } from '../data/negocio';
---

<section class="seccion" id="adicionales">
  <div class="contenedor">
    <div data-aparece>
      <p class="etiqueta">Servicios adicionales</p>
      <h2 class="titulo-seccion">Para tu hogar, <em>finca o negocio</em></h2>
      <p class="intro">Todo con instalación y configuración. Los valores son de referencia y dependen de los equipos y la distancia.</p>
    </div>

    <ul class="rejilla">
      {adicionales.map((a, i) => (
        <li class="item" style={`--i: ${i % 3}`} data-aparece>
          <div class="arriba">
            <span class="icono-caja"><Icono nombre={a.icono} /></span>
            <h3>{a.titulo}</h3>
          </div>
          <ul class="detalles">
            {a.detalles.map((d) => <li>{d}</li>)}
          </ul>
          <div class="abajo">
            <p class="precio">{a.precio}<small>{a.detallePrecio}</small></p>
            <a class="cotizar" href={enlaceWhatsapp(`Hola LinkNet, quiero cotizar: ${a.titulo}.`)} target="_blank" rel="noopener" aria-label={`Cotizar ${a.titulo} por WhatsApp`}>
              <Icono nombre="whatsapp" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px;
    border-radius: var(--radio);
    background: #fff;
    border: 1px solid var(--linea);
    transition: transform 400ms var(--salida), border-color 300ms, box-shadow 400ms;
  }

  .item:hover {
    transform: translateY(-5px);
    border-color: rgba(242, 140, 40, 0.5);
    box-shadow: var(--sombra);
  }

  .arriba {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .icono-caja {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: var(--noche);
    background: linear-gradient(135deg, #fff1e2, #fde7a8);
    transition: transform 500ms var(--salida);
  }

  .item:hover .icono-caja {
    transform: rotate(-10deg);
  }

  .icono-caja :global(.icono) {
    width: 24px;
    height: 24px;
  }

  h3 {
    font-size: 19px;
    line-height: 1.25;
  }

  .detalles {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
    align-content: start;
    font-size: 15px;
    color: var(--tenue);
  }

  .detalles li {
    position: relative;
    padding-left: 18px;
  }

  .detalles li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--verde);
  }

  .abajo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px dashed var(--linea);
  }

  .precio {
    display: grid;
    font-size: 19px;
    font-weight: 800;
    color: var(--naranja-fuerte);
    line-height: 1.2;
  }

  .precio small {
    font-size: 13px;
    font-weight: 500;
    color: var(--tenue);
  }

  .cotizar {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: #fff;
    background: #1faa53;
    transition: transform 300ms var(--salida);
  }

  .cotizar:hover {
    transform: scale(1.1) rotate(-8deg);
  }

  .cotizar :global(.icono) {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 960px) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
